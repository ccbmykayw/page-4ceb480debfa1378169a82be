plate-columns:1fr;gap:36px}\n    .grid-cards{grid-template-columns:1fr 1fr;gap:36px}\n    .steps{grid-template-columns:1fr 1fr}\n    .faq-grid{grid-template-columns:1fr;gap:0}\n    .topnav{display:none}\n    .foot-grid{grid-template-columns:1fr}\n  }\n  @media (max-width:560px){\n    .grid-cards{grid-template-columns:1fr}\n    .steps{grid-template-columns:1fr}\n    section{padding:48px 0}\n    .hero{padding:44px 0 52px}\n    .hero-meta{gap:24px}\n  }\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"brandmark\"><span class=\"dot\"></span>星雨幻境</div>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#notes\">计费说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">星雨幻境 / 订阅与使用说明</span>\n        <h1>星雨幻境，用一张<em>对比表</em>就能看清的订阅选择</h1>\n        <p class=\"lede\">这一页只做三件事：把三档订阅的差异并排列出，说明各平台的接入步骤，以及把容易产生误解的地方提前写清楚。所有内容以下方表格与文字为准。</p>\n        <div class=\"hero-meta\">\n          <div><b>3</b>档订阅</div>\n          <div><b>4</b>步接入流程</div>\n          <div><b>12</b>条常见问题</div>\n        </div>\n      </div>\n      <aside class=\"panel\" aria-label=\"页面速览\">\n        <h2>本页速览</h2>\n        <dl>\n          <dt>订阅档位</dt><dd>基础版 / 旗舰版 / 团队版</dd>\n          <dt>计费方式</dt><dd>按月或按年，年付以页面标注为准</dd>\n          <dt>设备额度</dt><dd>随档位递增，详见对比表</dd>\n          <dt>接入方式</dt><dd>客户端内填入订阅信息</dd>\n          <dt>支持渠道</dt><dd>工单，旗舰版起标注优先</dd>\n        </dl>\n        <p class=\"note\">本页不承诺任何具体速率、节点数量或线路质量，相关指标以实际开通后所见为准。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01 — 订阅方案</span>\n        <h2>三档订阅的差异，横向放在同一张表里</h2>\n        <p>表格按“月付价格、年付价格、流量、设备数、线路与支持”六个维度排列。同一行从左到右即为逐档递进，方便你直接判断需要哪一列。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          订阅方案对比 · 价格与权益以表格内文字为准，未列出的项目不在承诺范围内\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th>旗舰版<span class=\"tag\">常用</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small>每月</small></span></td>\n              <td><span class=\"price\">¥35<small>每月</small></span></td>\n              <td><span class=\"price\">¥85<small>每月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td>¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路说明</th>\n              <td>普通线路节点池</td>\n              <td class=\"yes\">全节点原生流媒体解锁，IPLC 专线游戏加速优化</td>\n              <td class=\"yes\">VIP 专属高带宽节点，支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体</td>\n              <td>全节点原生解锁</td>\n              <td>全节点原生解锁</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>工单</td>\n              <td>7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合情形</th>\n              <td>单人或少量设备日常使用</td>\n              <td>多设备、同时有游戏与流媒体需求</td>\n              <td>多人协作、需要统一管理与路由配置</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-foot\">年付金额为一次性支付全年的总额，并非在月付基础上叠加。表中未出现的权益（例如节点数量、地区分布、带宽数值）不属于本页承诺内容，请勿据此推断。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02 — 客户端</span>\n        <h2>先选平台，再按四个步骤接入</h2>\n        <p>客户端由你所在平台的官方渠道提供，本页不提供下载地址，也不代为分发安装包。下表只说明各平台对应哪个入口类别。</p>\n      </div>\n\n      <div class=\"clients\">\n        <ul class=\"client-list\">\n          <li>\n            <div><span class=\"cname\">桌面端 · Windows</span><span class=\"cdesc\">常规图形界面客户端，适合长期在电脑上使用。</span></div>\n            <span class=\"cnote\">系统应用商店或官方渠道</span>\n          </li>\n          <li>\n            <div><span class=\"cname\">桌面端 · macOS</span><span class=\"cdesc\">与系统代理设置配合使用，需在系统设置中授权。</span></div>\n            <span class=\"cnote\">系统应用商店或官方渠道</span>\n          </li>\n          <li>\n            <div><span class=\"cname\">桌面端 · Linux</span><span class=\"cdesc\">以命令行或精简界面方式运行，需自行配置。</span></div>\n            <span class=\"cnote\">发行版软件源</span>\n          </li>\n          <li>\n            <div><span class=\"cname\">移动端 · iOS</span><span class=\"cdesc\">从 App Store 获取，具体可用客户端以商店结果显示为准。</span></div>\n            <span class=\"cnote\">App Store</span>\n          </li>\n          <li>\n            <div><span class=\"cname\">移动端 · Android</span><span class=\"cdesc\">从应用商店或官方发布页获取，注意核对来源。</span></div>\n            <span class=\"cnote\">应用商店</span>\n          </li>\n          <li>\n            <div><span class=\"cname\">路由器 · 自建网关</span><span class=\"cdesc\">适合团队版统一管理，需具备基础网络配置能力。</span></div>\n            <span class=\"cnote\">自行部署</span>\n          </li>\n        </ul>\n\n        <div>\n          <h3>接入步骤</h3>\n          <div class=\"steps\">\n            <div class=\"step\">\n              <span class=\"n\">01</span>\n              <h3>确定档位</h3>\n              <p>按上表核对流量与设备数，先判断哪一列覆盖你的实际使用量。</p>\n            </div>\n            <div class=\"step\">\n              <span class=\"n\">02</span>\n              <h3>获取订阅信息</h3>\n              <p>开通后你会拿到一段订阅信息，内容仅用于当前账号，请勿转发给他人。</p>\n            </div>\n            <div class=\"step\">\n              <span class=\"n\">03</span>\n              <h3>填入客户端</h3>\n              <p>在所选客户端的订阅或配置位置粘贴该信息，保存后等待同步完成。</p>\n            </div>\n            <div class=\"step\">\n              <span class=\"n\">04</span>\n              <h3>核对设备数</h3>\n              <p>同时在线的设备数量不要超过档位上限，超出时新设备可能无法接入。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03 — 使用说明</span>\n        <h2>日常使用中需要自行把关的几件事</h2>\n        <p>以下条目属于使用层面的提醒，不涉及性能承诺。读一遍可以减少大部分操作失误。</p>\n      </div>\n      <div class=\"grid-cards\">\n        <div class=\"card\">\n          <span class=\"idx\">A / 01</span>\n          <h3>订阅信息等同于钥匙</h3>\n          <p>任何拿到这段信息的人都可能消耗你的流量额度。不要在群聊、截图或共享文档中公开它。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">A / 02</span>\n          <h3>设备额度按在线计</h3>\n          <p>额度统计的是同一时间在线的设备。退出客户端后再换设备，通常不会额外占用名额。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">A / 03</span>\n          <h3>流量按周期重置</h3>\n          <p>每月流量在你的计费周期起点重置，不结转至下个周期，也不会因中途升级而叠加。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">A / 04</span>\n          <h3>系统时间要正确</h3>\n          <p>设备时间偏差过大时，客户端校验常会失败。遇到无法同步，先检查系统时间与自动校准。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">A / 05</span>\n          <h3>更换设备先退出</h3>\n          <p>换机时在旧设备上退出客户端，再在新设备填入信息，可避免旧会话继续占用额度。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">A / 06</span>\n          <h3>按需选择档位</h3>\n          <p>不需要全部功能时，选覆盖用量的一档即可。档位差异见第一部分的对比表。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"notes\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04 — 计费与变更</span>\n        <h2>付费、续期与档位变更的处理方式</h2>\n        <p>这一部分说明规则本身，不涉及退款承诺。任何实际处理结果以工单答复为准。</p>\n      </div>\n      <div class=\"grid-cards\">\n        <div class=\"card\">\n          <span class=\"idx\">B / 01</span>\n          <h3>两种计费周期</h3>\n          <p>月付按月结算，年付一次性支付全年。年付金额见对比表，属于整年总额。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">B / 02</span>\n          <h3>续期不自动加量</h3>\n          <p>续期仅延长使用周期，不会因为累计付费而提升流量或设备上限，档位需单独变更。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">B / 03</span>\n          <h3>档位变更的边界</h3>\n          <p>升级后的额度从变更生效时起按新档位计算；周期内的计费差额如何结算，请提交工单确认。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"idx\">B / 04</span>\n          <h3>团队版的额外配置</h3>\n          <p>团队版涉及多人设备与企业定制路由，需在开通后与专属客户经理确认配置范围后再部署。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">05 — 常见问题</span>\n        <h2>十二个具体问题与对应回答</h2>\n        <p>问题按“订阅、计费、客户端、使用”四类交错排列，左右两栏顺序阅读即可。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div class=\"faq-item\">\n          <h3>三档订阅的核心差别是什么？</h3>\n          <p>主要是每月流量、同时在线设备数与线路类别。基础版为普通线路节点池，旗舰版为全节点原生解锁并含 IPLC 专线游戏优化，团队版增加 VIP 高带宽节点与企业定制路由。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>年付和月付的价格怎么理解？</h3>\n          <p>月付是每月支付一次，年付是一次性支付全年总额。表中给出的年付金额为整年费用，不是月付价格的折扣算法说明。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>流量用完了会怎样？</h3>\n          <p>当月额度用尽后，通常需等待下个计费周期重置，或按工单答复的方式处理。是否可临时补充额度，本页不作承诺。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>设备数上限是怎么计算的？</h3>\n          <p>按同一时间在线的设备数量计算。基础版 3 台、旗舰版 5 台、团队版 20 台。退出客户端后一般不再占用名额。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>可以在多台设备上轮流使用吗？</h3>\n          <p>可以，只要同时在线数量不超过档位上限。建议换机时先在旧设备退出，避免旧会话持续占用额度。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>本页提供软件下载吗？</h3>\n          <p>不提供。客户端请从对应平台的官方渠道获取，本页仅说明各平台应使用的入口类别，不代为分发安装包。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>订阅信息填进客户端后没有同步，怎么办？</h3>\n          <p>先确认信息完整且未过期，其次检查系统时间是否自动校准，再尝试重新保存配置。仍不成功可通过工单说明平台与现象。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>不同平台的接入方式一样吗？</h3>\n          <p>步骤一致，都是确定档位、获取信息、填入客户端、核对设备数。差别在于各平台可用的客户端不同，见客户端一节的列表。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>支持方式有什么区别？</h3>\n          <p>基础版为工单，旗舰版为 7×24 优先工单，团队版配专属客户经理。响应表现不在本页承诺范围内。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>团队版需要提前准备什么？</h3>\n          <p>需要明确接入的设备范围与路由需求，并安排一位对接人。企业定制路由的具体配置需在开通后与客户经理确认。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>本页是否承诺速率或线路质量？</h3>\n          <p>不承诺。本页只描述档位包含的功能类别，未列出速率数值、节点数量、地区分布与可用性指标。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>对计费结果有疑问该怎么处理？</h3>\n          <p>保留计费周期与档位记录，通过工单说明争议点。本页不提供退款条款，实际处理以工单答复为准。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"fbrand\">星雨幻境</div>\n        <p>本页为星雨幻境的订阅与使用说明页面，内容包含三档订阅对比、客户端入口类别、接入步骤与常见问题。页面信息以所列文字为准。</p>\n      </div>\n      <div>\n        <div class=\"foot-links\">\n          <a href=\"#plans\">订阅方案</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#usage\">使用说明</a>\n          <a href=\"#notes\">计费说明</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n    </div>\n    <div class=\"rule\"></div>\n    <p>星雨幻境 · 页面内容仅用于说明订阅结构与使用方式，不构成性能或结果的承诺。</p>\n  </div>\n</footer>",
